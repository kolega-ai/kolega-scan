{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolega-scan/ground-truth/v1.0.0",
  "title": "Ground Truth Entry",
  "type": "object",
  "required": ["repo_id", "commit_sha", "language", "authorship", "findings"],
  "properties": {
    "repo_id": { "type": "string" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "language": { "type": "string" },
    "framework": { "type": ["string", "null"] },
    "authorship": {
      "enum": ["human_authored", "llm_assisted", "llm_generated", "unknown"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "file", "primary_cwe", "acceptable_cwes",
          "is_vulnerable", "severity", "evidence"
        ],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "location": {
            "type": "object",
            "required": ["start_line", "end_line"],
            "properties": {
              "start_line": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 },
              "function": { "type": ["string", "null"] }
            }
          },
          "primary_cwe": { "type": "string", "pattern": "^CWE-\\d+$" },
          "acceptable_cwes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^CWE-\\d+$" }
          },
          "is_vulnerable": { "type": "boolean" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "evidence": {
            "type": "object",
            "required": ["source"],
            "properties": { "source": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
