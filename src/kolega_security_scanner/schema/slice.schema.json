{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolega-scan/slice/v1.0.0",
  "title": "Slice Manifest",
  "type": "object",
  "oneOf": [
    {
      "required": ["repos"],
      "not": { "required": ["include"] },
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    {
      "required": ["include"],
      "not": { "required": ["repos"] },
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  ]
}
